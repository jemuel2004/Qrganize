# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Local database dump
qr_ganized.session.sql

# MaxMind GeoLite2 local database (download separately; see data/geoip/README.md)
/data/geoip/*.mmdb
/data/geoip/*.mmdb.gz
/data/geoip/*.tar.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

