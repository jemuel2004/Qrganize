# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local database dump
qr_ganized.session.sql
*.dump

# User uploads (profile photos, system logo) — personal data, never committed.
# Production stores them in the database (uploaded_files); see DEPLOYMENT.md.
apps/backend/public/uploads/

# MaxMind GeoLite2 local database (download separately; see apps/backend/data/geoip/README.md)
apps/backend/data/geoip/*.mmdb
apps/backend/data/geoip/*.mmdb.gz
apps/backend/data/geoip/*.tar.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

