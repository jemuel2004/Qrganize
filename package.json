{
  "name": "qrganize",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev -w @qrganize/frontend",
    "dev:backend": "npm run dev -w @qrganize/backend",
    "build": "npm run build -w @qrganize/backend && npm run build -w @qrganize/frontend",
    "build:frontend": "npm run build -w @qrganize/frontend",
    "build:backend": "npm run build -w @qrganize/backend",
    "start:frontend": "npm run start -w @qrganize/frontend",
    "start:backend": "npm run start -w @qrganize/backend",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p apps/frontend && tsc --noEmit -p apps/backend && tsc --noEmit -p packages/shared",
    "test": "tsx --test packages/shared/src/curriculumImport/curriculumImport.test.ts packages/shared/src/curriculumExport/curriculumExport.test.ts packages/shared/src/classroomDemand.test.ts packages/shared/src/regularLoad.test.ts packages/shared/src/subjectCategory.test.ts packages/shared/src/blockCode.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
