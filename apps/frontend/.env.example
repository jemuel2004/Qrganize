# Frontend (Vercel in production, apps/frontend/.env.local locally). No secrets here.

# Backend URL — Render service URL in production, http://localhost:4000 locally.
# The browser never calls it directly: /api/* and /uploads/* are forwarded to it.
BACKEND_URL=https://qrganize-backend.onrender.com

# Same Google OAuth client ID as the backend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
