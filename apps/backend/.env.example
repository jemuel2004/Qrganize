# Backend (Render in production, apps/backend/.env.local locally).
# Copy to .env.local for local development. Never commit real values.

# Neon: use the POOLED connection string (host contains "-pooler") with sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random strings (Render can generate them). Changing JWT_SECRET signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
OTP_SECRET=change-me-to-another-long-random-string

# Google sign-in (Google Cloud Console → OAuth client ID, Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Email for login / password codes (Gmail: use an App Password, not the login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=QRganize <your-gmail@gmail.com>

# Behind a proxy (Render / Vercel): trust X-Forwarded-For for the real client IP
TRUST_PROXY=true

# Optional extra folder for older uploads on disk (uploads are stored in the database).
# Leave unset; apps/backend/public/uploads is always checked as well.
# UPLOAD_DIR=/var/data/uploads
